<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Forge — Live Code Editor</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div id="app">
  <div id="topbar">
    <div class="brand"><span class="dot"></span>FORGE</div>

    <select id="templateSelect" title="Start from a template">
      <option value="">Templates…</option>
      <option value="blank">Blank</option>
      <option value="landing">Landing page</option>
      <option value="card">Animated card</option>
      <option value="todo">Todo list</option>
    </select>

    <div class="seg" id="layoutSeg">
      <button data-layout="split" class="active">Split</button>
      <button data-layout="editor">Editor</button>
      <button data-layout="preview">Preview</button>
    </div>

    <div class="spacer"></div>

    <span id="status">Ready</span>
    <button class="icon" id="saveBtn" title="Save snippet to your library">💾 Save</button>
    <button class="icon" id="libraryBtn" title="Open snippet library">📂 Library</button>
    <button class="icon" id="shareBtn" title="Copy a shareable link">🔗 Share</button>
    <button class="primary" id="runBtn" title="Re-run preview">▶ Run</button>
  </div>

  <div id="body">
    <div id="editors" style="flex:1;">
      <div class="tabs">
        <div class="tab active" data-lang="html"><span class="tagdot"></span>index.html</div>
        <div class="tab" data-lang="css"><span class="tagdot"></span>style.css</div>
        <div class="tab" data-lang="js"><span class="tagdot"></span>script.js</div>
      </div>
      <div id="pane-html" class="editor-pane active"></div>
      <div id="pane-css" class="editor-pane"></div>
      <div id="pane-js" class="editor-pane"></div>
    </div>

    <div id="resizer"></div>

    <div id="preview-wrap" style="flex:1;">
      <div id="preview-bar">
        <span class="urlchip">about:srcdoc</span>
        <span id="autoRunLabel">auto-run on</span>
      </div>
      <iframe id="preview" sandbox="allow-scripts allow-modals allow-forms allow-popups"></iframe>
    </div>
  </div>
</div>

<!-- Library modal -->
<div class="modal-overlay" id="libraryModal">
  <div class="modal">
    <h3>Saved snippets</h3>
    <div id="snippetList"><div class="empty-state">No snippets saved yet.</div></div>
    <div class="close-row"><button id="closeLibraryBtn">Close</button></div>
  </div>
</div>

<!-- Save modal -->
<div class="modal-overlay" id="saveModal">
  <div class="modal">
    <h3>Save snippet</h3>
    <input type="text" id="saveNameInput" placeholder="Snippet name…">
    <div class="close-row">
      <button id="cancelSaveBtn">Cancel</button>
      <button class="primary" id="confirmSaveBtn">Save</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
<script src="script.js"></script>
</body>
</html>


//css //


:root{
  --bg: #0d1117;
  --panel: #11161d;
  --panel-2: #161c25;
  --line: #232b36;
  --text: #d7dee8;
  --muted: #6b7785;
  --accent: #ff8a3d;
  --accent-dim: #ff8a3d33;
  --html-tag: #7dd3fc;
  --css-tag: #a78bfa;
  --js-tag: #fbbf24;
  --mono: "JetBrains Mono", "Fira Code", ui-monospace, Menlo, Consolas, monospace;
  --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
*{box-sizing:border-box;}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);overflow:hidden;}

#app{display:flex;flex-direction:column;height:100vh;}

/* ---------- Top bar ---------- */
#topbar{
  display:flex;align-items:center;gap:14px;
  padding:0 16px;height:52px;flex:0 0 52px;
  background:var(--panel);border-bottom:1px solid var(--line);
}
.brand{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-weight:700;letter-spacing:.5px;color:var(--text);margin-right:6px;}
.brand .dot{width:9px;height:9px;border-radius:2px;background:var(--accent);transform:rotate(45deg);}
select, button{
  font-family:var(--sans);font-size:13px;border-radius:6px;border:1px solid var(--line);
  background:var(--panel-2);color:var(--text);padding:7px 10px;cursor:pointer;
}
select:hover, button:hover{border-color:var(--accent);}
button.primary{background:var(--accent);color:#1a0e05;border-color:var(--accent);font-weight:600;}
button.primary:hover{filter:brightness(1.08);}
button.icon{padding:7px 9px;}
.seg{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
.seg button{border:none;border-radius:0;background:var(--panel-2);}
.seg button.active{background:var(--accent-dim);color:var(--accent);}
.spacer{flex:1;}
#status{font-family:var(--mono);font-size:11px;color:var(--muted);min-width:80px;}

/* ---------- Body layout ---------- */
#body{flex:1;display:flex;min-height:0;}

#editors{display:flex;flex-direction:column;min-width:0;border-right:1px solid var(--line);}
#editors.hidden{display:none;}
#preview-wrap{flex:1;min-width:0;display:flex;flex-direction:column;}
#preview-wrap.hidden{display:none;}

.tabs{display:flex;background:var(--panel);border-bottom:1px solid var(--line);flex:0 0 38px;}
.tab{
  display:flex;align-items:center;gap:7px;padding:0 16px;font-family:var(--mono);font-size:12.5px;
  color:var(--muted);cursor:pointer;border-right:1px solid var(--line);user-select:none;
}
.tab .tagdot{width:7px;height:7px;border-radius:50%;}
.tab[data-lang="html"] .tagdot{background:var(--html-tag);}
.tab[data-lang="css"] .tagdot{background:var(--css-tag);}
.tab[data-lang="js"] .tagdot{background:var(--js-tag);}
.tab.active{color:var(--text);background:var(--panel-2);border-bottom:2px solid var(--accent);}

.editor-pane{flex:1;min-height:0;display:none;}
.editor-pane.active{display:block;}

#preview-bar{
  display:flex;align-items:center;gap:8px;padding:0 12px;height:38px;flex:0 0 38px;
  background:var(--panel);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--muted);
}
#preview-bar .urlchip{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:6px;padding:4px 10px;color:var(--muted);}
iframe#preview{flex:1;border:none;background:#fff;width:100%;}

/* resizer */
#resizer{width:5px;cursor:col-resize;background:var(--panel);flex:0 0 5px;}
#resizer:hover{background:var(--accent-dim);}

/* ---------- Modal (snippets / share) ---------- */
.modal-overlay{position:fixed;inset:0;background:#000a;display:none;align-items:center;justify-content:center;z-index:50;}
.modal-overlay.show{display:flex;}
.modal{background:var(--panel);border:1px solid var(--line);border-radius:10px;width:460px;max-width:92vw;max-height:80vh;overflow:auto;padding:18px 20px;}
.modal h3{margin:0 0 12px;font-size:14px;font-family:var(--mono);color:var(--accent);}
.modal input[type=text]{width:100%;padding:8px 10px;background:var(--panel-2);border:1px solid var(--line);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12.5px;margin-bottom:10px;}
.snippet-row{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border:1px solid var(--line);border-radius:6px;margin-bottom:6px;background:var(--panel-2);}
.snippet-row .name{font-family:var(--mono);font-size:12.5px;}
.snippet-row .meta{font-size:11px;color:var(--muted);}
.snippet-row .acts{display:flex;gap:6px;}
.snippet-row button{padding:4px 8px;font-size:11px;}
.modal .close-row{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;}
.empty-state{color:var(--muted);font-size:12.5px;font-family:var(--mono);padding:14px 4px;}
.toast{
  position:fixed;bottom:18px;left:50%;transform:translateX(-50%);
  background:var(--panel-2);border:1px solid var(--accent);color:var(--text);
  padding:9px 16px;border-radius:7px;font-family:var(--mono);font-size:12.5px;
  opacity:0;pointer-events:none;transition:opacity .25s, transform .25s;z-index:60;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(-6px);}


//js file//

const TEMPLATES = {
