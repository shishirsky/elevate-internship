let editors = {};
let currentLang = 'html';
let autoRunTimer = null;

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 1800);
}

function buildPreviewDoc(){
  const html = editors.html.getValue();
  const css = editors.css.getValue();
  const js = editors.js.getValue();
  return `<!DOCTYPE html><html><head><style>${css}</style></head><body>${html.replace(/<\/?(!DOCTYPE|html|head|body)[^>]*>/gi,'')}<script>${js}<\/script></body></html>`;
}

function runPreview(){
  document.getElementById('preview').srcdoc = buildPreviewDoc();
  document.getElementById('status').textContent = 'Ran ' + new Date().toLocaleTimeString();
}

function scheduleAutoRun(){
  clearTimeout(autoRunTimer);
  autoRunTimer = setTimeout(runPreview, 500);
}

function loadTemplate(name){
  const t = TEMPLATES[name] || TEMPLATES.blank;
  editors.html.setValue(t.html);
  editors.css.setValue(t.css);
  editors.js.setValue(t.js);
  runPreview();
}

function getState(){
  return { html: editors.html.getValue(), css: editors.css.getValue(), js: editors.js.getValue() };
}
function setState(s){
  editors.html.setValue(s.html||'');
  editors.css.setValue(s.css||'');
  editors.js.setValue(s.js||'');
  runPreview();
}

/* ---------- Sharing via URL hash ---------- */
function encodeState(s){
  return btoa(unescape(encodeURIComponent(JSON.stringify(s))));
}
function decodeState(str){
  return JSON.parse(decodeURIComponent(escape(atob(str))));
}
function shareLink(){
  const encoded = encodeState(getState());
  const url = location.origin + location.pathname + '#code=' + encoded;
  navigator.clipboard.writeText(url).then(()=>{
    showToast('Share link copied to clipboard');
  }).catch(()=>{
    showToast('Could not copy — see console');
    console.log(url);
  });
}

/* ---------- Snippet library (persistent storage) ---------- */
async function saveSnippet(name){
  const id = 'snippet:' + Date.now();
  const payload = { name, ...getState(), savedAt: Date.now() };
  try{
    await window.storage.set(id, JSON.stringify(payload));
    showToast('Saved "' + name + '"');
  }catch(e){
    showToast('Save failed');
    console.error(e);
  }
}

async function listSnippets(){
  const listEl = document.getElementById('snippetList');
  listEl.innerHTML = '<div class="empty-state">Loading…</div>';
  try{
    const res = await window.storage.list('snippet:');
    const keys = (res && res.keys) || [];
    if(!keys.length){
      listEl.innerHTML = '<div class="empty-state">No snippets saved yet.</div>';
      return;
    }
    const items = [];
    for(const k of keys){
      try{
        const r = await window.storage.get(k);
        if(r) items.push({ key: k, data: JSON.parse(r.value) });
      }catch(e){}
    }
    items.sort((a,b)=> (b.data.savedAt||0) - (a.data.savedAt||0));
    listEl.innerHTML = '';
    items.forEach(item=>{
      const row = document.createElement('div');
      row.className = 'snippet-row';
      const date = item.data.savedAt ? new Date(item.data.savedAt).toLocaleString() : '';
      row.innerHTML = `
        <div>
          <div class="name">${escapeHtml(item.data.name||'untitled')}</div>
          <div class="meta">${date}</div>
        </div>
        <div class="acts">
          <button data-act="load">Load</button>
          <button data-act="delete">Delete</button>
        </div>`;
      row.querySelector('[data-act=load]').addEventListener('click', ()=>{
        setState(item.data);
        document.getElementById('libraryModal').classList.remove('show');
        showToast('Loaded "' + item.data.name + '"');
      });
      row.querySelector('[data-act=delete]').addEventListener('click', async ()=>{
        await window.storage.delete(item.key);
        listSnippets();
      });
      listEl.appendChild(row);
    });
  }catch(e){
    listEl.innerHTML = '<div class="empty-state">Could not load snippets.</div>';
    console.error(e);
  }
}

function escapeHtml(s){
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ---------- Layout ---------- */
function setLayout(mode){
  document.querySelectorAll('#layoutSeg button').forEach(b=>b.classList.toggle('active', b.dataset.layout===mode));
  const editorsEl = document.getElementById('editors');
  const previewEl = document.getElementById('preview-wrap');
  const resizer = document.getElementById('resizer');
  editorsEl.classList.remove('hidden');
  previewEl.classList.remove('hidden');
  resizer.style.display = '';
  if(mode==='editor'){ previewEl.classList.add('hidden'); resizer.style.display='none'; }
  else if(mode==='preview'){ editorsEl.classList.add('hidden'); resizer.style.display='none'; }
  setTimeout(()=>{ Object.values(editors).forEach(e=>e.layout()); }, 50);
}

/* ---------- Resizer drag ---------- */
function initResizer(){
  const resizer = document.getElementById('resizer');
  const editorsEl = document.getElementById('editors');
  let dragging = false;
  resizer.addEventListener('mousedown', ()=>{ dragging = true; document.body.style.cursor='col-resize'; });
  window.addEventListener('mousemove', e=>{
    if(!dragging) return;
    const bodyRect = document.getElementById('body').getBoundingClientRect();
    const newWidth = e.clientX - bodyRect.left;
    editorsEl.style.flex = `0 0 ${Math.max(200, Math.min(newWidth, bodyRect.width-200))}px`;
    Object.values(editors).forEach(ed=>ed.layout());
  });
  window.addEventListener('mouseup', ()=>{ dragging=false; document.body.style.cursor=''; });
}

/* ---------- Init ---------- */
require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' }});
require(['vs/editor/editor.main'], function(){
  monaco.editor.defineTheme('forge-dark', {
    base: 'vs-dark', inherit: true, rules: [],
    colors: { 'editor.background': '#11161d' }
  });

  editors.html = monaco.editor.create(document.getElementById('pane-html'), {
    value: TEMPLATES.blank.html, language: 'html', theme: 'forge-dark',
    automaticLayout: true, minimap:{enabled:false}, fontSize:13, fontFamily:"JetBrains Mono, monospace"
  });
  editors.css = monaco.editor.create(document.getElementById('pane-css'), {
    value: TEMPLATES.blank.css, language: 'css', theme: 'forge-dark',
    automaticLayout: true, minimap:{enabled:false}, fontSize:13, fontFamily:"JetBrains Mono, monospace"
  });
  editors.js = monaco.editor.create(document.getElementById('pane-js'), {
    value: TEMPLATES.blank.js, language: 'javascript', theme: 'forge-dark',
    automaticLayout: true, minimap:{enabled:false}, fontSize:13, fontFamily:"JetBrains Mono, monospace"
  });

  Object.values(editors).forEach(ed => ed.onDidChangeModelContent(scheduleAutoRun));

  // load from share link if present
  const hash = location.hash;
  if(hash.startsWith('#code=')){
    try{
      const s = decodeState(hash.slice(6));
      setState(s);
      showToast('Loaded shared snippet');
    }catch(e){ runPreview(); }
  } else {
    runPreview();
  }

  initResizer();
});

/* ---------- Tabs ---------- */
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.editor-pane').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    currentLang = tab.dataset.lang;
    document.getElementById('pane-'+currentLang).classList.add('active');
    setTimeout(()=> editors[currentLang] && editors[currentLang].layout(), 30);
  });
});

/* ---------- Top bar actions ---------- */
document.getElementById('runBtn').addEventListener('click', runPreview);
document.getElementById('templateSelect').addEventListener('change', e=>{
  if(e.target.value) loadTemplate(e.target.value);
  e.target.value = '';
});
document.querySelectorAll('#layoutSeg button').forEach(b=>{
  b.addEventListener('click', ()=> setLayout(b.dataset.layout));
});
document.getElementById('shareBtn').addEventListener('click', shareLink);

document.getElementById('saveBtn').addEventListener('click', ()=>{
  document.getElementById('saveNameInput').value='';
  document.getElementById('saveModal').classList.add('show');
  document.getElementById('saveNameInput').focus();
});
document.getElementById('cancelSaveBtn').addEventListener('click', ()=> document.getElementById('saveModal').classList.remove('show'));
document.getElementById('confirmSaveBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('saveNameInput').value.trim() || 'Untitled snippet';
  await saveSnippet(name);
  document.getElementById('saveModal').classList.remove('show');
});

document.getElementById('libraryBtn').addEventListener('click', ()=>{
  document.getElementById('libraryModal').classList.add('show');
  listSnippets();
});
document.getElementById('closeLibraryBtn').addEventListener('click', ()=> document.getElementById('libraryModal').classList.remove('show'));
