<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To Do Landing Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="top">
        <div class="box">

            <div class="logo">
                <img src="elevate.jpeg" alt="Logo">
            </div>

            <nav>
                <ul class="menu">
                    <li><a href="#">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </nav>

        </div>
    </header>

    <!-- Main Section -->
    <section class="main">

        <div class="todo-box">

            <h1>To Do List</h1>

            <div class="input-box">
                <input type="text" id="taskInput" placeholder="Enter task">
                <button id="addBtn">Add</button>
            </div>

            <ul id="taskList"></ul>

        </div>

    </section>

    <!-- Footer -->
    <footer class="bottom">

        <p>2026 My Website | All Rights Reserved</p>

        <div class="links">
            <a href="#">Instagram</a>
            <a href="#">GitHub</a>
            <a href="#">LinkedIn</a>
        </div>

    </footer>

    <script src="script.js"></script>

</body>
</html>




* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
}

/* Header */
.top {
    background-color: rgb(238, 157, 7);
    padding: 15px 0;
    position: relative;
}

.box {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    position: relative;
}

/* Logo */
.logo {
    position: relative;
}

.logo img {
    width: 90px;
    height: 90px;
    position: absolute;
    top: -20px;
    left: 0;
    border-radius: 50%;
    object-fit: cover;
}

/* Menu */
.menu {
    list-style: none;
    display: flex;
    gap: 20px;
    margin-left: 100px;
}

.menu a {
    color: rgb(54, 10, 185);
    text-decoration: none;
    font-size: 18px;
}

.menu a:hover {
    color: rgb(24, 175, 225);
}

/* Main */
.main {
    min-height: 80vh;
    background-color: rgb(174, 195, 168);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
}

/* To Do Box */
.todo-box {
    background-color: rgb(14, 194, 218);
    width: 400px;
    padding: 20px;
    border-radius: 10px;
}

.todo-box h1 {
    text-align: center;
    margin-bottom: 20px;
}

.input-box {
    display: flex;
    gap: 10px;
}

.input-box input {
    flex: 1;
    padding: 10px;
}

.input-box button {
    padding: 10px 20px;
    background-color: blue;
    color: rgb(234, 237, 209);
    border: none;
    cursor: pointer;
}

ul {
    list-style: none;
    margin-top: 20px;
}

li {
    background-color: #f4f4f4;
    margin-bottom: 10px;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.done {
    text-decoration: line-through;
}

.remove-btn {
    background-color: red;
    color: white;
    border: none;
    padding: 8px 12px;
    cursor: pointer;
}

/* Footer */
.bottom {
    background-color: rgb(4, 54, 31);
    color: rgb(145, 150, 150);
    text-align: center;
    padding: 20px;
}

.links {
    margin-top: 10px;
}

.links a {
    color: rgb(13, 211, 106);
    text-decoration: none;
    margin: 10px;
}

/* Tablet */
@media (max-width: 768px) {

    .box {
        flex-direction: column;
        gap: 25px;
        text-align: center;
    }

    .logo img {
        position: static;
        width: 70px;
        height: 70px;
    }

    .menu {
        margin-left: 0;
        flex-wrap: wrap;
        justify-content: center;
    }

    .todo-box {
        width: 100%;
        max-width: 400px;
    }
}

/* Mobile */
@media (max-width: 480px) {

    .menu {
        flex-direction: column;
        gap: 10px;
    }

    .input-box {
        flex-direction: column;
    }

    .input-box button {
        width: 100%;
    }

    .links {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
}


let addBtn = document.getElementById("addBtn");
let taskInput = document.getElementById("taskInput");
let taskList = document.getElementById("taskList");

addBtn.addEventListener("click", function () {

    let taskText = taskInput.value;

    if (taskText === "") {
        return;
    }

    let li = document.createElement("li");

    let span = document.createElement("span");
    span.innerText = taskText;

    span.addEventListener("click", function () {
        span.classList.toggle("done");
    });

    let removeBtn = document.createElement("button");
    removeBtn.innerText = "Delete";
    removeBtn.classList.add("remove-btn");

    removeBtn.addEventListener("click", function () {
        li.remove();
    });

    li.appendChild(span);
    li.appendChild(removeBtn);

    taskList.appendChild(li);

    taskInput.value = "";
});
