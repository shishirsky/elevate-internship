<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Landing Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="top">
        <div class="box">

            <!-- Logo Image -->
            <div class="logo">
                <img src="elevate.jpeg" alt="Logo">
            </div>

            <!-- Menu -->
            <nav>
                <ul class="menu">
                    <li><a href="#">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </nav>

        </div>
    </header>

    <!-- Main Section -->
    <section class="main">
        <div class="text">
            <h1>Welcome To My Website</h1>

            <p>
                This is a simple responsive landing page made using
                HTML and CSS. It works on mobile and desktop screen.
            </p>

            <a href="#" class="button">Get Started</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bottom">
        <p>2026 My Website | All Rights Reserved</p>

        <div class="links">
            <a href="#">Instagram</a>
            <a href="#">GitHub</a>
            <a href="#">LinkedIn</a>
        </div>
    </footer>

</body>
</html>


css file

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
}

/* Header */
.top {
    background-color: black;
    padding: 15px 0;
    position: relative;
}

.box {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    position: relative;
}

/* Logo */
.logo {
    position: relative;
}

.logo img {
    width: 90px;
    height: 90px;
    object-fit: cover;
    border-radius: 50%;

    /* Logo overlap */
    position: absolute;
    top: -20px;
    left: 0;
}

/* Menu */
.menu {
    list-style: none;
    display: flex;
    gap: 20px;

    /* space for logo */
    margin-left: 100px;
}

.menu li {
    list-style: none;
}

.menu a {
    color: white;
    text-decoration: none;
    font-size: 18px;
}

.menu a:hover {
    color: lightblue;
}

/* Main Section */
.main {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: lightgray;
    padding: 40px 20px;
}

.text {
    max-width: 600px;
}

.text h1 {
    font-size: 40px;
    margin-bottom: 15px;
}

.text p {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 20px;
}

/* Button */
.button {
    display: inline-block;
    background-color: blue;
    color: white;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 5px;
}

.button:hover {
    background-color: darkblue;
}

/* Footer */
.bottom {
    background-color: black;
    color: white;
    text-align: center;
    padding: 20px;
}

.links {
    margin-top: 10px;
}

.links a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
}

.links a:hover {
    color: lightblue;
}

/* Tablet */
@media (max-width: 768px) {

    .box {
        flex-direction: column;
        text-align: center;
        gap: 25px;
    }

    /* Fix logo for tablet/mobile */
    .logo img {
        position: static;
        width: 70px;
        height: 70px;
    }

    .menu {
        margin-left: 0;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .text h1 {
        font-size: 32px;
    }

    .text p {
        font-size: 16px;
    }
}

/* Mobile */
@media (max-width: 480px) {

    .menu {
        flex-direction: column;
        gap: 10px;
    }

    .text h1 {
        font-size: 26px;
    }

    .text p {
        font-size: 15px;
    }

    .button {
        padding: 10px 16px;
    }

    .links {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
}
